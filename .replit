modules = ["python-3.11"]
run = "pip install -q -r requirements.txt && gunicorn --bind 0.0.0.0:5000 app:app"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["pip", "install", "-r", "requirements.txt"]
run = ["gunicorn", "--bind", "0.0.0.0:5000", "app:app"]
